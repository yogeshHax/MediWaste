{
  "name": "mediwaste-verifypoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-firestore.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "emu": "firebase emulators:start --only auth,firestore --project demo-medwaste",
    "functions:emulator": "firebase emulators:start --only functions --project demo-medwaste",
    "firmware:verify": "echo 'Arduino firmware: see hardware/firmware/ — build with Arduino IDE / arduino-cli'",
    "test": "playwright test",
    "test:protocol": "tsx scripts/test-station-protocol.mjs",
    "functions:build": "cd functions && npm install && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "latest",
    "firebase": "11.3.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "latest",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "latest",
    "three": "^0.186.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.1.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
